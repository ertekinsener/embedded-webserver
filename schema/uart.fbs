// UART configuration API (webserver/README.md, "API").
namespace webserver.api;

enum WordLength : byte {
  Bits_7 = 0,
  Bits_8 = 1,
  Bits_9 = 2
}

enum StopBits : byte {
  Bits_1 = 0,
  Bits_0_5 = 1,
  Bits_2 = 2,
  Bits_1_5 = 3
}

enum Parity : byte {
  None = 0,
  Even = 1,
  Odd = 2
}

enum FlowControl : byte {
  None = 0,
  RTS = 1,
  CTS = 2,
  RTS_CTS = 3
}

enum Oversampling : byte {
  Over16 = 0,
  Over8 = 1
}

// Line settings of one port. POST /api/uart/config applies them (204, or
// 404 unknown port, 422 unsupported or refused by the hardware).
table UartSettings {
  port_id: uint8;
  baud_rate: uint32 = 115200;
  word_length: WordLength = Bits_8;
  stop_bits: StopBits = Bits_1;
  parity: Parity = None;
  flow_control: FlowControl = None;
  oversampling: Oversampling = Over16;
  fifo_enabled: bool = false;
  tx_rx_swap: bool = false;
}

// What a port supports, which depends on the platform and the board (e.g.
// flow control only where RTS/CTS pins are wired). The UI offers only these.
table UartCapabilities {
  min_baud_rate: uint32;
  max_baud_rate: uint32;
  word_lengths: [WordLength];
  stop_bits: [StopBits];
  parities: [Parity];
  flow_controls: [FlowControl];
  oversampling: [Oversampling];
  fifo: bool;        // fifo_enabled may be changed.
  tx_rx_swap: bool;  // tx_rx_swap may be changed.
}

// How a port is bridged to the network (docs/bridge/README.md).
enum BridgeMode : byte {
  TcpServer = 0,  // Raw TCP server on local_port.
  Rfc2217 = 1,    // Telnet with COM Port Control (RFC 2217) on local_port.
  TcpClient = 2,  // Connects to remote_address:remote_port.
  Udp = 3         // Datagrams on local_port, sent to remote_address:
                  // remote_port or, if unset, to the last sender.
}

// Ethernet bridge of one port. POST /api/bridge/config applies it (204;
// 404 unknown port; 422 no bridge on this port, values out of range, a
// local port below 1024 or used by another bridge, a client mode without
// remote address).
table BridgeSettings {
  port_id: uint8;
  enabled: bool;
  mode: BridgeMode = TcpServer;
  local_port: uint16;
  remote_address: [ubyte];  // IPv4, 4 bytes.
  remote_port: uint16;
  idle_gap_ms: uint16;      // 0: flush when the UART goes idle.
  max_frame: uint16 = 1024;
  use_delimiter: bool;      // Also flush when `delimiter` arrives.
  delimiter: ubyte = 10;
}

table BridgeStatus {
  listening: bool;
  connected: bool;
  client_address: [ubyte];  // IPv4, empty without a client.
  client_port: uint16;
  uart_to_net_bytes: uint32;
  net_to_uart_bytes: uint32;
  dropped_bytes: uint32;    // UART data with no client to take it.
  uart_errors: uint32;
}

table UartPort {
  id: uint8;
  name: string;
  description: string;
  capabilities: UartCapabilities;
  settings: UartSettings;
  // Absent if the port has no bridge (e.g. the console).
  bridge: BridgeSettings;
  bridge_status: BridgeStatus;
}

// GET /api/uart/ports.
table UartPortList {
  ports: [UartPort];
}

root_type UartSettings;
