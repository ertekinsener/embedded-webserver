// Login API (README.md, "API").
namespace webserver.api;

// POST /api/auth/login (public).
table LoginRequest {
  username: string;
  password: string;
}

// Answer to a successful login. The token goes into later requests as
// "Authorization: Bearer <token>"; the session ends after `idle_timeout_s`
// without requests, on logout or on reboot.
table LoginResponse {
  token: string;
  idle_timeout_s: uint32;
}

// POST /api/auth/password (session): replaces the password (204). 403
// wrong current password (counts as a failed login), 422 new password
// shorter than 8 or longer than 64 bytes, 429 locked out. The other
// sessions end; the password is saved if the device can store settings.
table ChangePasswordRequest {
  current_password: string;
  new_password: string;
}

root_type LoginRequest;
